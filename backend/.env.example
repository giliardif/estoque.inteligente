# Copie para .env.staging e .env.production com valores reais.
# NUNCA commitar .env.staging ou .env.production no git — apenas este .env.example.
# Em produção, essas variáveis devem vir do painel do Railway (secrets), não de arquivo.

ENV=development

# Staging e produção DEVEM apontar para bancos Postgres/Supabase distintos e isolados
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/estoque_dev

# Conexão dedicada do papel auth_service (BYPASSRLS escopado a users/refresh_tokens/tenants).
# Em desenvolvimento pode repetir DATABASE_URL; em produção deve ser um usuário distinto.
AUTH_DATABASE_URL=postgresql+asyncpg://auth_service:password@localhost:5432/estoque_dev

# Gerar com: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

ALLOWED_ORIGINS=["http://localhost:3000"]

RATE_LIMIT_DEFAULT=100/minute
RATE_LIMIT_AUTH=5/minute

MAX_UPLOAD_SIZE_MB=5

# Supabase Storage — upload de imagem de produto. SERVICE_ROLE_KEY é secreta,
# NUNCA usar a anon key aqui nem expor no frontend.
SUPABASE_URL=https://qzprfrbfabqczhzwwpkw.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=produtos-imagens
MAX_IMAGEM_PRODUTO_SIZE_MB=3
